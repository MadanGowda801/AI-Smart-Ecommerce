# ==============================================================================
# Smart E-Commerce Platform — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local development.
# 2. For production deployments (Vercel, Netlify, Docker, VPS, etc.), configure
#    these environment variables in your deployment platform's dashboard.
# 3. DO NOT COMMIT `.env`, `.env.local`, OR `.env.production` TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC CONFIGURATION (Accessible in Browser)
#    These variables are baked into the frontend bundle during build.
#    They MUST use the `VITE_` prefix and MUST ONLY contain public-safe keys.
# ------------------------------------------------------------------------------

# Public base URL for the InsForge Backend (PostgreSQL / BaaS)
VITE_INSFORGE_URL=https://<your-project-subdomain>.insforge.app

# Public Anonymous API Key (Protected by PostgreSQL Row-Level Security policies)
VITE_INSFORGE_ANON_KEY=anon_<your-public-anon-key-here>

# Public Razorpay Key ID (Client-side checkout dialog)
# For Test/Sandbox: rzp_test_<alphanumeric>
# For Production/Live: rzp_live_<alphanumeric>
VITE_RAZORPAY_KEY_ID=rzp_test_<your-razorpay-key-id>

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRET CONFIGURATION (NEVER EXPOSE TO BROWSER / CLIENT BUNDLE)
#    These variables are loaded by server processes (Vite plugin, Node, Edge Functions).
#    They MUST NOT start with `VITE_`.
# ------------------------------------------------------------------------------

# Backend URL for InsForge operations
INSFORGE_URL=https://<your-project-subdomain>.insforge.app

# Privileged InsForge API / Service-Role Key (Bypasses RLS for server-side verification)
# WARNING: Keep this strictly confidential! Never expose to client!
INSFORGE_API_KEY=key_<your-secret-service-role-api-key>

# Razorpay Secret Key (Used for server-side HMAC-SHA256 signature verification)
# WARNING: Keep this strictly confidential! Never expose to client!
RAZORPAY_KEY_SECRET=<your-secret-razorpay-key-secret>

# Payment Gateway Operational Mode:
# Set to 'test' for development sandbox / mock simulation
# Set to 'live' for real production transactions (disables test signature simulation)
PAYMENT_GATEWAY_MODE=test


# AI Model Gateway (SERVER-SIDE ONLY — never prefix with VITE_)
# Obtain from: https://aistudio.google.com/app/apikey
# Used for: AI natural-language product search (Feature 1) and defect detection (Feature 5)
# Leave blank to disable LLM enhancement; the rule-based engine acts as automatic fallback.
GEMINI_API_KEY=

# Optional: override model used for AI search
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. SERVER NETWORKING & HOSTING CONFIGURATION (Optional / Defaults provided)
# ------------------------------------------------------------------------------
PORT=5173
NODE_ENV=development
